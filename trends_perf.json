px0":1375.0,"d0":"2026-10-21","px":1320.0,"ret":-4.0},"6129":{"n":"普誠","px0":14.1,"d0":"2026-10-21","px":12.1,"ret":-14.2}},"stage":"成形","last":"2026-11-04","mk0":108.15,"mk0_d":"2026-10-21","avg":-11.6,"n":5,"win":0,"mk":-7.0,"days":14},"ai-robotics-integration":{"name":"AI機器人整合","first":"2026-10-17","stage0":"萌芽","base":{"2049":{"n":"上銀","px0":311.0,"d0":"2026-10-16","px":297.5,"ret":-4.3},"8081":{"n":"致新","px0":269.5,"d0":"2026-10-16","px":251.0,"ret":-6.9},"6414":{"n":"樺漢","px0":404.5,"d0":"2026-10-16","px":357.0,"ret":-11.7},"3665":{"n":"貿聯-KY","px0":2015.0,"d0":"2026-10-16","px":1575.0,"ret":-21.8},"2302":{"n":"麗正","px0":43.75,"d0":"2026-10-16","px":39.3,"ret":-10.2}},"stage":"萌芽","last":"2026-11-04","mk0":109.0,"mk0_d":"2026-10-16","avg":-11.0,"n":5,"win":0,"mk":-7.7,"days":18}},"scores":{"2330":{"n":"台積電","ai":9,"d":"2026-11-01","txt":"產業未來2至3年受惠AI與高效能運算需求強勁，先進製程與High NA EUV技術升級帶動成長。台積電憑藉技術領先穩居半導體製造核心，3奈米與5奈米出貨比重持續擴大，獲利動能強。最大風險包含營業毛利率微幅下滑及擴廠伴隨的工安與地緣政治挑戰。"},"2301":{"n":"光寶科","ai":8,"d":"2026-11-01","txt":"產業未來2~3年動能來自AIDC基礎建設擴張、伺服器電源升級至800VDC與液冷整合。公司居關鍵電源供應地位，高階AI電源與雲端運算營收大幅成長，2026年AI營收占比將過三成。最大風險為存貨週轉天數拉長與現金循環天數增加導致的營運資金壓力。"},"3324":{"n":"雙鴻","ai":8,"d":"2026-11-01","txt":"未來2至3年AI伺服器與HPC高階運算需求強勁，液冷散熱技術全面普及為核心成長動能。雙鴻成功重返輝達供應鏈並擴大水冷板與CDU等完整液冷零件布局，確立其關鍵地位。最大風險為伺服器業務佔比過高帶來的客戶集中度與需求波動風險。"},"3034":{"n":"聯詠","ai":8,"d":"2026-11-04","txt":"產業受惠於手機換機潮與邊緣AI晶片需求，帶動顯示驅動IC與SoC業務成長。聯詠"},"3189":{"n":"景碩","ai":9,"d":"2026-11-04","txt":"產業受AI、HPC驅動，先進封裝載板需求結構性成長。景碩為ABF與BT載板關鍵"},"6182":{"n":"合晶","ai":7,"d":"2026-11-04","txt":"產業未來2至3年受惠半導體庫存去化後需求回升，以及AI、光通訊與先進封裝帶動矽晶圓與新式材料升級。合晶身處其中，透過彰化二林廠與鄭州廠擴充12吋及化合物半導體產能，並布局SOI與中介層等高附加價值產品。最大風險在於擴產資本支出龐大、自由現金流為負，且短期毛利率與獲利能力承受壓力。"},"6271":{"n":"同欣電","ai":8,"d":"2026-11-04","txt":"未來2-3年產業成長動能來自AI光通訊（800G量產）、低軌衛星與車用第三代半導體（SiC）需求。同欣電身為高階陶瓷基板與混合積體電路模組關鍵供應者，轉型AI光通訊成效浮現，帶動毛利率與獲利顯著躍升。最大風險為旺季動能收斂及短期成長力道趨於平緩。"},"2382":{"n":"廣達","ai":8,"d":"2026-11-04","txt":"AI伺服器需求強勁，廣達作為關鍵供應商，受惠於Vera Rubin等產品放量，營收規模顯"},"3231":{"n":"緯創","ai":8,"d":"2026-11-04","txt":"未來2-3年AI伺服器與運算設備需求強勁，緯創成功轉型Wistron 3.0，在AI生態系占據全機櫃與運算板等關鍵供應地位。最大風險為擴產導致負債比與利息費用顯著上升，且面臨現金流壓力及地緣政治挑戰。"},"6669":{"n":"緯穎","ai":8,"d":"2026-11-04","txt":"未來2至3年受惠雲端資料中心與AI伺服器強勁需求，推動整櫃技術與CPO光學傳輸等升級趨勢。緯穎身處CSP直供與高階AI伺服器關鍵供應鏈，具備規模擴大與毛利優化優勢。最大風險在於庫存大幅攀升與營業費用快速增長帶來的備貨與去化壓力。"},"2357":{"n":"華碩","ai":8,"d":"2026-11-04","txt":"未來2-3年產業成長動能來自AI PC換機潮、輝達RTX Spark旗艦機及資料中心伺服器需求。華碩具備高階產品策略與品牌優勢，伺服器業務呈爆發性成長且商用PC市佔擴張。最大風險為庫存水位偏高導致現金循環天數拉長，以及零組件漲價與資安事件對營運造成的潛在壓力。"}},"u":"2026-11-04 10:41","mk_d":"2026-11-03"}